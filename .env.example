# Copy this file to .env and fill in ONE (or more) of the keys below.
# .env is git-ignored and must never be committed.
#
# The app uses the first key that is set, in this order: Anthropic, OpenAI, Gemini.
# Gemini has a free tier: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: force a provider when several keys are set (anthropic | openai | gemini)
# PROVIDER=gemini

# Optional: override the default model of a provider
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-6-luna
# GEMINI_MODEL=gemini-3.6-flash

# Optional: retrieval tuning (re-run ingest.py after changing EMBED_MODEL or CHUNK_*)
# TOP_K=5
# MIN_SIMILARITY=0.5
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# EMBED_MODEL=BAAI/bge-small-en-v1.5
